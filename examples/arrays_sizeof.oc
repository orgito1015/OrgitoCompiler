// Arrays: fixed-size declarations, array parameters decaying to pointers,
// and the sizeof operator on types, expressions, and structs.

struct Pair {
    int a;
    int b;
};

int sum_array(int arr[], int n) {
    int total = 0;
    for (int i = 0; i < n; i++) {
        total += arr[i];
    }
    return total;
}

int main() {
    int nums[5];
    for (int i = 0; i < 5; i++) nums[i] = i * i;

    print(sum_array(nums, 5));

    int *p = nums;
    print(*(p + 2));

    print(sizeof(int));
    print(sizeof(nums));
    print(sizeof(struct Pair));

    return 0;
}
